# Supabase project URL and publishable/anon key.
# Both are safe for the browser; RLS and SQL functions enforce authorization.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Schema that contains the POS tables. Use `public` on a fresh project, or
# `macrobox_pos` when the isolated-schema migration is used.
NEXT_PUBLIC_SUPABASE_SCHEMA=macrobox_pos

# `supabase` (default) uses the live project above. `local` runs the same SQL
# migration in PGlite, useful for sandboxed previews without outbound DB access.
# NEXT_PUBLIC_POS_LIVE_MODE=supabase

# Optional: password for the seeded demo accounts. Used only by the one-click
# demo sign-in server action. Never expose this to the browser.
# POS_DEMO_PASSWORD=

# Optional: enable a future real map in the Driver portal. The current UI uses
# a clearly labelled simulated/placeholder map and does not require a key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: server-side provisioning scripts only. Never expose this to the browser.
# The POS Server Actions in app/actions/pos.ts do NOT require it.
# SUPABASE_SERVICE_ROLE_KEY=
