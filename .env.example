# ---------------------------------------------------------------------------
# Public Supabase configuration — safe for the browser.
# RLS and SQL functions remain the final authorization boundary.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Schema containing the POS tables. Use `public` on a fresh project, or
# `macrobox_pos` when the isolated-schema migration is used.
NEXT_PUBLIC_SUPABASE_SCHEMA=macrobox_pos

# `supabase` (default) uses the live project above. `local` runs the same SQL
# migrations in PGlite for sandboxed previews without outbound DB access.
NEXT_PUBLIC_POS_LIVE_MODE=supabase

# Canonical production origin, used for links and Supabase Auth redirect config.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# ---------------------------------------------------------------------------
# SERVER-ONLY — required for OTP profile provisioning and email-link callbacks.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
# In Vercel, store this as an encrypted/sensitive environment variable.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Customer authentication
# ---------------------------------------------------------------------------
# Production uses Supabase Auth phone OTP (SMS) plus optional email magic links.
# Configure a production SMS provider (Twilio / MessageBird / Vonage /
# Textlocal) in the Supabase Auth dashboard; the provider credentials are NOT
# stored in this repository or in Vercel. The local PGlite preview uses a fixed
# preview OTP of 123456 automatically and never sends real SMS.
#
# Local verification only. Do not set either variable in production.
# ---------------------------------------------------------------------------
# POS_DEMO_PASSWORD=
# POS_ENABLE_DEMO_SIGNIN=false

# Optional: enable a future real map in the Driver portal. The current UI uses
# a clearly labelled simulated/placeholder map and does not require a key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
